<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyTitle>RDCore.Forms</AssemblyTitle>
    <Description>RDForms' form model, with no UI dependency: component classes, their properties and events, the instances of a form, the reader and writer of the RDForms document (a constrained XAML dialect), and the reader that imports a VB6 designer file (.frm, .ctl, .pag) into the model.</Description>
    <!-- it ships inside the RDCore.Forms package, which RDCore.Forms.Avalonia packs. NuGet's restore names a project by its package ID, so
         this one, never packed, has an ID of its own: two projects named RDCore.Forms are an ambiguous project name. -->
    <IsPackable>false</IsPackable>
    <PackageId>RDCore.Forms.Model</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- a picture is read and decoded as the SDK reads and decodes it, and a font is drawn at the size the SDK's StdFont reads back; a
         ComboBox, in RDCore.Forms.Avalonia, matches a word typed as the language server's completion matches a name. -->
    <PackageReference Include="RDCore.SDK" Version="$(RDCoreSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- rdc export-library's description of VB6.OLB, as RDCore's Symbols folder has it; RDFormsLibraries adds RDForms' members to it. -->
    <EmbeddedResource Include="Libraries/VB.json" LogicalName="RDCore.Forms.Libraries.VB.json" />
  </ItemGroup>

</Project>
