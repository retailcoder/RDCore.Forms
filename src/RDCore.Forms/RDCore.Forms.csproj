<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyTitle>RDCore.Forms</AssemblyTitle>
    <Description>RDForms' form model, with no UI dependency: component classes, their properties and events, the instances of a form, the reader and writer of the RDForms document (a constrained XAML dialect), and the reader that imports a VB6 designer file (.frm, .ctl, .pag) into the model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- a picture is read and decoded as the SDK reads and decodes it, and a font is drawn at the size the SDK's StdFont reads back; a
         ComboBox, in RDCore.Forms.Avalonia, matches a word typed as the language server's completion matches a name. -->
    <PackageReference Include="RDCore.SDK" Version="0.1.5-alpha" />
  </ItemGroup>

</Project>
