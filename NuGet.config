<?xml version="1.0" encoding="utf-8"?>
<!-- LOCAL ONLY: the RDCore.SDK package from a local folder feed (a dotnet pack of an SDK branch under a version no release uses,
     0.1.5-local.<sha>), restored into a packages folder of its own so that this machine's global packages folder never caches a local
     build under a version nuget.org will publish. A branch with this file restores on this machine only, and stays off CI. The SDK
     release that holds the picture header reader replaces it: the version becomes that release's, and this file goes. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="C:\Dev\Claude\sdk-loadpicture-feed-packages" />
  </config>
  <packageSources>
    <add key="rdcore-sdk-local" value="C:\Dev\Claude\sdk-loadpicture-feed" />
  </packageSources>
</configuration>
