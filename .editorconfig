[*.cs]

# SYSLIB1054: Use 'LibraryImportAttribute' instead of 'DllImportAttribute' to generate P/Invoke marshalling code at compile time
dotnet_diagnostic.SYSLIB1054.severity = silent

# VSTHRD003: Avoid awaiting foreign Tasks.
# The deadlock it guards against is a task started on a JoinableTaskFactory main thread, awaited from that thread. These libraries use no
# JoinableTaskFactory: a control's UI work runs on Avalonia's dispatcher, and awaiting a task another component started is how they wait for each other.
dotnet_diagnostic.VSTHRD003.severity = none

[tests/**.cs]

# VSTHRD200: Use "Async" suffix for async methods.
# The Task-returning methods of the tests are the helpers of their own test class, which nothing else calls; a task one of them returns that is not
# awaited is already an error here (CS4014, RDCore.Forms.Tests.csproj), which is what the suffix exists to make visible.
dotnet_diagnostic.VSTHRD200.severity = none
